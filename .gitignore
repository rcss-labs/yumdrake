.idea/
.superpowers/
/bin/
/coverage.out

# Built web application, embedded by internal/webui (make web-build)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Terraform: never commit state, plugins or real variable values
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# Production Compose settings: secrets live here, never commit it.
/deploy/compose/.env
# Backups hold password hashes and encrypted secrets; keep them outside the checkout.
/deploy/compose/*.dump
/deploy/compose/yumdrake-*.tar.gz
