# Settings of the DEMO (deploy/compose/compose.demo.yaml). Everything here is
# public and committed on purpose: the demo runs on fake steps, holds no real
# data and works only on localhost (the services refuse the demo key anywhere
# else). Never copy these values into a real setup.
#
# Used as: docker compose -p yumdrake-demo --env-file deploy/compose/demo/demo.env \
#   -f deploy/compose/compose.yaml -f deploy/compose/compose.demo.yaml up -d --build --wait
# Do not set COMPOSE_FILE here: there is no HTTPS front in the demo.

# The images are built locally by the demo overlay and never pulled.
YUMDRAKE_IMAGE_REPO=yumdrake-demo
YUMDRAKE_VERSION=local

# Open http://localhost:18280
YUMDRAKE_HTTP_PORT=18280
YUMDRAKE_PUBLIC_URL=http://localhost:18280

YUMDRAKE_DATABASE_PASSWORD=demo-only
YUMDRAKE_VALKEY_PASSWORD=demo-only
# The public demo key: base64 of "yumdrake-demo-key-not-a-secret!!".
YUMDRAKE_LOCAL_SECRET_KEY=eXVtZHJha2UtZGVtby1rZXktbm90LWEtc2VjcmV0ISE=

YUMDRAKE_RUNNER_REPLICAS=1
