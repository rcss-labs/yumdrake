# Copy to .env (cp .env.example .env), replace every <placeholder>, and keep .env
# private: it holds secrets and is git-ignored. Docker Compose reads it
# automatically when run in this directory.

# Which Compose files to use. This line includes the HTTPS front (Caddy). For
# plain HTTP on 127.0.0.1 only (for example behind your own proxy), use: compose.yaml
COMPOSE_FILE=compose.yaml:compose.tls.yaml

# Registry and repository that hold the Yumdrake images.
YUMDRAKE_IMAGE_REPO=ghcr.io/rcss-labs
# The release to run: a git tag. Check out that tag, change it, then run: docker compose pull --ignore-buildable && docker compose up -d --build
YUMDRAKE_VERSION=v1.0.0

# DNS name of this host. Caddy gets a certificate for it (needs ports 80 and 443 reachable).
YUMDRAKE_PUBLIC_HOST=<yumdrake.example.com>
# The address people type in the browser. Must match YUMDRAKE_PUBLIC_HOST (https://<host>),
# and must include the port (https://<host>:8443) when YUMDRAKE_HTTPS_PORT is not 443,
# or sign-in fails with an origin error.
YUMDRAKE_PUBLIC_URL=https://<yumdrake.example.com>

# Host port for HTTPS, served by Caddy.
YUMDRAKE_HTTPS_PORT=443
# Host port for the HTTP to HTTPS redirect (also used for certificate validation).
YUMDRAKE_HTTP_REDIRECT_PORT=80
# Without the HTTPS front: the address and port the orchestrator publishes (ignored with it).
YUMDRAKE_HTTP_BIND=127.0.0.1
YUMDRAKE_HTTP_PORT=8080

# PostgreSQL password for the yumdrake database user. Generate: openssl rand -hex 24
YUMDRAKE_DATABASE_PASSWORD=<generated-password>
# Valkey password. Generate: openssl rand -hex 24
YUMDRAKE_VALKEY_PASSWORD=<generated-password>
# 32-byte key (base64) that encrypts connections, config copies and log archives.
# Generate: openssl rand -base64 32
# Back it up separately from the data: without it those are unreadable. Never change it later.
YUMDRAKE_LOCAL_SECRET_KEY=<generated-key>

# Number of runner containers.
YUMDRAKE_RUNNER_REPLICAS=2
# Log level of both services: debug, info, warn or error.
YUMDRAKE_LOG_LEVEL=info

# AWS access (optional). Leave these empty to use an instance role on this host.
# The orchestrator's identity may assume only discovery roles; the runner's only
# deployment roles. Use two different IAM users, never the same one.
YUMDRAKE_ORCHESTRATOR_AWS_ACCESS_KEY_ID=
YUMDRAKE_ORCHESTRATOR_AWS_SECRET_ACCESS_KEY=
YUMDRAKE_RUNNER_AWS_ACCESS_KEY_ID=
YUMDRAKE_RUNNER_AWS_SECRET_ACCESS_KEY=
# Region for the AWS SDK default (optional).
YUMDRAKE_AWS_REGION=
# Send AWS calls to another endpoint, for example a local emulator (optional).
# Passed to both services as YUMDRAKE_AWS_ENDPOINT_URL and AWS_ENDPOINT_URL.
YUMDRAKE_AWS_ENDPOINT_URL=
